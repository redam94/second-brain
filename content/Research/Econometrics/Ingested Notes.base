filters:
  and:
    - file.inFolder("Research/Econometrics")
    - '!file.hasTag("type/index")'
    - file.ext == "md"
properties:
  doc_type:
    displayName: Type
  source:
    displayName: Source
  source_location:
    displayName: Location
  date_created:
    displayName: Created
  status:
    displayName: Status
  file.folder:
    displayName: Subfolder
views:
  - type: table
    name: All Econometrics Notes
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - doc_type
      - source
      - source_location
      - date_created
      - status
