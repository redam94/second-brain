filters:
  and:
    - file.inFolder("Research/Econometrics/Extensions/Simulation-Based Estimation")
    - or:
        - file.hasTag("type/theorem")
        - file.hasTag("type/definition")
properties:
  source:
    displayName: Source
  source_location:
    displayName: Location
  doc_type:
    displayName: Type
views:
  - type: table
    name: Theorems and Definitions
    order:
      - file.name
      - source_location
      - source
