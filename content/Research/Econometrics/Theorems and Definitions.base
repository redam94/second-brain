filters:
  and:
    - file.inFolder("Research/Econometrics")
    - or:
        - file.hasTag("type/theorem")
        - file.hasTag("type/definition")
properties:
  source:
    displayName: Source
  source_location:
    displayName: Location
  doc_type:
    displayName: Type
  file.folder:
    displayName: Subfolder
views:
  - type: table
    name: Theorems and Definitions
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - source
      - source_location
      - doc_type
