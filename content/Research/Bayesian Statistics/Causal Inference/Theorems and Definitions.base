filters:
  and:
    - file.inFolder("Research/Bayesian Statistics/Causal Inference")
    - file.hasTag("type/theorem") || file.hasTag("type/definition")
properties:
  source_location:
    displayName: Location
  doc_type:
    displayName: Doc Type
views:
  - type: table
    name: Theorems and Definitions
    order:
      - file.name
      - source_location
      - doc_type
