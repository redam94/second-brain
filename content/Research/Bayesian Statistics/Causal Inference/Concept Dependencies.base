filters:
  and:
    - file.hasTag("source/ingested")
    - file.inFolder("Research/Bayesian Statistics/Causal Inference")
    - '!file.hasTag("type/index")'
    - '!file.hasTag("type/overview")'
properties:
  depends_on:
    displayName: Depends On
  used_by:
    displayName: Used By
views:
  - type: table
    name: Concept Dependency Graph
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - depends_on
      - used_by
      - file.folder
