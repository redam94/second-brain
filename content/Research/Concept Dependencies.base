filters:
  and:
    - file.hasTag("source/ingested")
    - '!file.hasTag("type/index")'
properties:
  depends_on:
    displayName: Depends On
  used_by:
    displayName: Used By
  tags:
    displayName: Tags
views:
  - type: table
    name: Concept Dependency Graph
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - depends_on
      - used_by
      - tags
