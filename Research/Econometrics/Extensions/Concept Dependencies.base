filters:
  and:
    - file.hasTag("source/ingested")
    - file.hasTag("topic/econometrics")
    - 'file.ext == "md"'
    - not:
        file.hasTag("type/index")

properties:
  depends_on:
    displayName: "Depends On"
  used_by:
    displayName: "Used By"

views:
  - type: table
    name: "Concept Dependencies"
    order:
      - file.name
      - depends_on
      - used_by
      - file.tags
    groupBy:
      property: doc_type
      direction: ASC
