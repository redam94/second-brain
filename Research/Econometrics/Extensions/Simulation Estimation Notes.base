filters:
  and:
    - file.inFolder("Research/Econometrics/Extensions")
    - '!file.hasTag("type/index")'
    - file.ext == "md"
properties:
  doc_type:
    displayName: Type
  source_location:
    displayName: Source Location
  date_created:
    displayName: Created
  status:
    displayName: Status
  file.folder:
    displayName: Subfolder
views:
  - type: table
    name: All Simulation Estimation Notes
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - doc_type
      - source_location
      - date_created
      - status
  - type: table
    name: Theorems and Definitions
    filters:
      or:
        - file.hasTag("type/theorem")
        - file.hasTag("type/definition")
    order:
      - file.name
      - source_location
      - date_created
