filters:
  and:
    - file.hasTag("source/ingested")
    - file.inFolder("Research/Causal Discovery")
    - file.ext == "md"
properties:
  doc_type:
    displayName: Type
  source:
    displayName: Source
  source_location:
    displayName: Location
  date_ingested:
    displayName: Ingested
views:
  - type: table
    name: Ingested Notes
    order:
      - file.name
      - doc_type
      - source
      - source_location
      - date_ingested
    sort:
      - property: date_ingested
        direction: DESC
