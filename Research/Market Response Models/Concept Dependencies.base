filters:
  and:
    - file.inFolder("Research/Market Response Models")
    - '!file.hasTag("type/index")'
    - file.ext == "md"
properties:
  depends_on:
    displayName: Depends On
  used_by:
    displayName: Used By
  doc_type:
    displayName: Type
  chapter:
    displayName: Chapter
  file.folder:
    displayName: Subfolder
views:
  - type: table
    name: Concept Dependency Graph
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - depends_on
      - used_by
      - doc_type
      - chapter
