filters:
  and:
    - file.inFolder("Research/Market Response Models")
    - '!file.hasTag("type/index")'
    - file.ext == "md"
properties:
  doc_type:
    displayName: Type
  source:
    displayName: Source
  source_location:
    displayName: Location
  date_created:
    displayName: Created
  status:
    displayName: Status
  chapter:
    displayName: Chapter
  file.folder:
    displayName: Subfolder
views:
  - type: table
    name: All Market Response Notes
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - doc_type
      - chapter
      - source_location
      - status
