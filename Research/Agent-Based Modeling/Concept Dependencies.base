filters:
  and:
    - file.hasTag("source/ingested")
    - file.inFolder("Research/Agent-Based Modeling")
    - '!file.hasTag("type/index")'

properties:
  file.name:
    displayName: "Concept"
  depends_on:
    displayName: "Depends On"
  used_by:
    displayName: "Used By"
  file.tags:
    displayName: "Tags"
  file.folder:
    displayName: "Folder"

views:
  - type: table
    name: "Concept Graph"
    order:
      - file.name
      - depends_on
      - used_by
      - file.tags
    groupBy:
      property: file.folder
      direction: ASC
