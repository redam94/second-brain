filters:
  and:
    - file.hasTag("source/ingested")
    - file.inFolder("Research/Bayesian Statistics/Causal Inference")
    - '!file.hasTag("type/index")'

properties:
  doc_type:
    displayName: Doc Type
  source_location:
    displayName: Location
  date_ingested:
    displayName: Ingested

views:
  - type: table
    name: All Ingested Notes
    order:
      - file.name
      - doc_type
      - source_location
      - date_ingested
      - file.folder
