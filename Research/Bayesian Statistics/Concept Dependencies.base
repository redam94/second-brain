filters:
  and:
    - file.inFolder("Research/Bayesian Statistics")
    - '!file.hasTag("type/index")'
    - 'file.ext == "md"'

properties:
  depends_on:
    displayName: Depends On
  used_by:
    displayName: Used By
  doc_type:
    displayName: Type
  file.folder:
    displayName: Subfolder

views:
  - type: table
    name: Concept Dependency Graph
    order:
      - file.name
      - depends_on
      - used_by
      - doc_type
    groupBy:
      property: file.folder
      direction: ASC
